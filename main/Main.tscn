[gd_scene format=3]

[ext_resource type="Script" path="res://main/main.gd" id="1_main"]
[ext_resource type="Script" path="res://dungeon/dungeon_generator.gd" id="2_generator"]
[ext_resource type="Resource" path="res://dungeon/catalog.tres" id="3_catalog"]
[ext_resource type="PackedScene" path="res://items/Pickup.tscn" id="4_pickup"]
[ext_resource type="PackedScene" path="res://player/Player.tscn" id="5_player"]
[ext_resource type="PackedScene" path="res://enemy/Enemy.tscn" id="6_enemy"]
[ext_resource type="Script" path="res://fx/fx_pool.gd" id="7_fx"]
[ext_resource type="PackedScene" path="res://fx/HitPuff.tscn" id="8_hit_puff"]
[ext_resource type="PackedScene" path="res://fx/BlockSpark.tscn" id="9_block_spark"]
[ext_resource type="Script" path="res://dungeon/dungeon.gd" id="10_dungeon"]

[sub_resource type="Environment" id="Environment_dungeon"]
background_mode = 1
background_color = Color(0.02, 0.018, 0.026, 1)
ambient_light_source = 2
ambient_light_color = Color(0.32, 0.3, 0.42, 1)
ambient_light_energy = 0.6
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.05, 0.045, 0.06, 1)
fog_density = 0.025

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_dungeon")

[node name="Dungeon" type="Node3D" parent="."]
script = ExtResource("10_dungeon")

[node name="Spawned" type="Node3D" parent="Dungeon"]

[node name="DungeonGenerator" type="Node" parent="." node_paths=PackedStringArray("dungeon", "spawned", "player")]
unique_name_in_owner = true
script = ExtResource("2_generator")
catalog = ExtResource("3_catalog")
dungeon = NodePath("../Dungeon")
spawned = NodePath("../Dungeon/Spawned")
player = NodePath("../Player")
pickup_scene = ExtResource("4_pickup")
enemy_scene = ExtResource("6_enemy")

[node name="FX" type="Node3D" parent="."]
script = ExtResource("7_fx")

[node name="HitPuffs" type="Node3D" parent="FX"]
unique_name_in_owner = true

[node name="HitPuff1" parent="FX/HitPuffs" instance=ExtResource("8_hit_puff")]

[node name="HitPuff2" parent="FX/HitPuffs" instance=ExtResource("8_hit_puff")]

[node name="HitPuff3" parent="FX/HitPuffs" instance=ExtResource("8_hit_puff")]

[node name="HitPuff4" parent="FX/HitPuffs" instance=ExtResource("8_hit_puff")]

[node name="BlockSparks" type="Node3D" parent="FX"]
unique_name_in_owner = true

[node name="BlockSpark1" parent="FX/BlockSparks" instance=ExtResource("9_block_spark")]

[node name="BlockSpark2" parent="FX/BlockSparks" instance=ExtResource("9_block_spark")]

[node name="BlockSpark3" parent="FX/BlockSparks" instance=ExtResource("9_block_spark")]

[node name="BlockSpark4" parent="FX/BlockSparks" instance=ExtResource("9_block_spark")]

[node name="Player" parent="." node_paths=PackedStringArray("fx", "dungeon", "drop_parent") instance=ExtResource("5_player")]
unique_name_in_owner = true
process_mode = 4
fx = NodePath("../FX")
pickup_scene = ExtResource("4_pickup")
dungeon = NodePath("../Dungeon")
drop_parent = NodePath("../Dungeon/Spawned")
