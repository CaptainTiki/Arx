[gd_resource type="Resource" script_class="SpawnTable" format=3]

[ext_resource type="Script" path="res://dungeon/spawn_table.gd" id="1_table"]
[ext_resource type="Script" path="res://dungeon/spawn_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://enemy/grunt.tres" id="3_grunt"]
[ext_resource type="Resource" path="res://enemy/skitterer.tres" id="4_skitterer"]
[ext_resource type="Resource" path="res://enemy/bruiser.tres" id="5_bruiser"]

[sub_resource type="Resource" id="Entry_grunt"]
script = ExtResource("2_entry")
weight = 5.0
enemy = ExtResource("3_grunt")

[sub_resource type="Resource" id="Entry_skitterer"]
script = ExtResource("2_entry")
weight = 3.0
enemy = ExtResource("4_skitterer")

[sub_resource type="Resource" id="Entry_bruiser"]
script = ExtResource("2_entry")
weight = 1.0
enemy = ExtResource("5_bruiser")

[sub_resource type="Resource" id="Entry_nothing"]
script = ExtResource("2_entry")
weight = 2.0

[resource]
script = ExtResource("1_table")
entries = Array[ExtResource("2_entry")]([SubResource("Entry_grunt"), SubResource("Entry_skitterer"), SubResource("Entry_bruiser"), SubResource("Entry_nothing")])
