[gd_resource type="Resource" script_class="SpawnTable" format=3]

[ext_resource type="Script" path="res://dungeon/spawn_table.gd" id="1_table"]
[ext_resource type="Script" path="res://dungeon/spawn_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://weapons/rusty_sword.tres" id="3_sword"]
[ext_resource type="Resource" path="res://weapons/woodcutters_axe.tres" id="4_axe"]
[ext_resource type="Resource" path="res://weapons/rusted_dagger.tres" id="5_dagger"]

